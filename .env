# ===== GEMINI API CONFIGURATION =====
GEMINI_API_KEY=your-gemini-api-key
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_COMPUTER_USE_MODEL=gemini-2.5-computer-use-preview-10-2025

# ===== BROWSERBASE CONFIGURATION =====
USE_BROWSERBASE=true
BROWSERBASE_API_KEY=your-browserbase-api-key
BROWSERBASE_PROJECT_ID=your-browserbase-session
BROWSERBASE_SESSION_ID= # leave blank to auto-create a new session

# ===== GROQ API CONFIGURATION =====
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# ===== TAVILY API CONFIGURATION =====
TAVILY_API_KEY=your-tavily-api-key

# ===== SERVER CONFIGURATION =====
PORT=3001
FRONTEND_URL=http://localhost:5173

# ===== BROWSER CONFIGURATION =====
HEADLESS_MODE=true
ANTI_BOT_ENABLED=true
ENABLE_STEALTH_MODE=true
ENABLE_FINGERPRINT_RANDOMIZATION=true

# ===== TIMEOUT CONFIGURATION =====
NAVIGATION_TIMEOUT=80000
ELEMENT_TIMEOUT=10000
ACTION_TIMEOUT=5000
VERIFICATION_TIMEOUT=8000

# ===== FEATURE FLAGS =====
SAVE_SCREENSHOTS=true
SAVE_HTML=true
CLOUDFLARE_SOLVING=true
PREFER_COMPUTER_USE=false
PREFER_COMPUTERUSE_FOR_COMPLEX_TASKS=true

# ===== LOGGING CONFIGURATION =====
LOG_LEVEL=info
LOG_FORMAT=json
LOG_TO_FILE=true
LOG_RETENTION_DAYS=30

# ===== TASK CONFIGURATION =====
MAX_STEPS=15
MAX_CONSECUTIVE_ERRORS=5
DEMOQA_MODE=false
COMPLEX_TASK_THRESHOLD=5

# ===== SCROLL PROTECTION =====
DISABLE_AUTO_SCROLL=true
SCROLL_RESTORE_AFTER_ACTION=true
